# Copy to .env in EACH worktree. scripts/bootstrap.sh does this for you and
# assigns non-colliding ports so several worktrees can run at once.

# Assigned by scripts/bootstrap.sh. Do not hardcode 3000/8000 anywhere.
FRONTEND_PORT=3000
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Deployed preview the reviewer inspects. Empty = reviewer falls back to local.
PREVIEW_URL=

# Project secrets. Never commit real values.
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

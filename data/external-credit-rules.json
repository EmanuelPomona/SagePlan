  "rules": [
    {
      "id": "ap-advanced-standing-credit",
      "effect": "credit",
      "match": {
        "kind": "AP",
        "minScore": 4
      },
      "explanation": "AP scores of 4 or 5 earn advanced standing credit: one credit for a year-long course, one-half for a semester-long course.",
      "sourceQuote": "Credit is awarded for scores of 4 or 5 on Advanced Placement (AP) exams; for scores of 6 or 7 on Higher-Level International Baccalaureate (IB) exams; and for comparable scores on GCE Advanced Level exams.",
      "sourceRef": {
        "slug": "academic-standing-credit",
        "url": "https://catalog.pomona.edu/pages/88p6CaMLyq7qCKR2TsNi"
      },
      "confidence": "verified"
    },
    {
      "id": "ib-hl-advanced-standing-credit",
      "effect": "credit",
      "match": {
        "kind": "IB",
        "levels": [
          "HL"
        ],
        "minScore": 6
      },
      "explanation": "IB Higher Level scores of 6 or 7 earn advanced standing credit. Standard Level exams never earn credit.",
      "sourceQuote": "for scores of 6 or 7 on Higher-Level International Baccalaureate (IB) exams",
      "sourceRef": {
        "slug": "academic-standing-credit",
        "url": "https://catalog.pomona.edu/pages/88p6CaMLyq7qCKR2TsNi"
      },
      "confidence": "verified"
    },
    {
      "id": "alevel-advanced-standing-credit",
      "effect": "credit",
      "match": {
        "kind": "ALEVEL",
        "minGrade": "B",
        "gradeScale": [
          "A*",
          "A",
          "B",
          "C",
          "D",
          "E"
        ]
      },
      "explanation": "A-Level exams earn advanced standing credit for comparable scores. The catalog does not publish the cutoff; this tool assumes a grade of B or better, which is unconfirmed.",
      "sourceQuote": "and for comparable scores on GCE Advanced Level exams.",
      "sourceRef": {
        "slug": "academic-standing-credit",
        "url": "https://catalog.pomona.edu/pages/88p6CaMLyq7qCKR2TsNi"
      },
      "confidence": "unverified"
    },
    {
      "id": "ap-language-requirement",
      "effect": "attribute",
      "match": {
        "kind": "AP",
        "category": "language",
        "minScore": 4
      },
      "grantsAttributes": [
        "LANGUAGE"
      ],
      "explanation": "An AP exam in a language other than English with a score of 4 or 5 satisfies the language requirement.",
      "sourceQuote": "By earning a score of 4 or 5 on an Advanced Placement examination in a language other than English;",
      "sourceRef": {
        "slug": "degree-requirements-tab-general-education-requirements",
        "url": "https://catalog.pomona.edu/pages/D3W4Xk0UrEr5WCruEh1T"
      },
      "confidence": "verified"
    },

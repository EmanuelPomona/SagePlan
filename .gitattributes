# Per-agent files: concurrent appends from different branches combine instead of conflicting.
docs/handoffs/*.md  merge=union
docs/status/*.md    merge=union
docs/tasks/*.md     merge=union

# Append-only ledgers: the reviewer appends on its branch, the manager appends on
# main, and neither should have to hand-resolve the other (ADR-019).
docs/DEBT.md         merge=union
docs/review/rounds.md merge=union

# Generated, like the lockfiles: concatenating two versions is never right and
# regenerating always is. Union produced two whole tables here, every task listed
# twice with contradictory columns, silently (ADR-021, measured 2026-09-11).
docs/tasks/INDEX.md  -merge

# Lockfiles must never be auto-merged. Regenerate after integration instead.
package-lock.json   -merge
pnpm-lock.yaml      -merge
yarn.lock           -merge
poetry.lock         -merge

# Review evidence is binary.
docs/review/*.png   binary
